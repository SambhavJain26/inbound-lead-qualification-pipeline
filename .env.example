# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   node scripts/generate-secrets.js             # writes encryption key + postgres password
#
# Then fill the CREDENTIALS block below from the accounts listed in
# docs/stage-1-setup.md, and run:
#
#   node scripts/setup-credentials.js           # imports them into n8n

# ---------------------------------------------------------------------------
# Local services
# ---------------------------------------------------------------------------
N8N_IMAGE=n8nio/n8n:latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
GENERIC_TIMEZONE=America/New_York

POSTGRES_IMAGE=postgres:16-alpine
# 5433 on the host to avoid clashing with any local Postgres on 5432.
POSTGRES_PORT=5433
POSTGRES_USER=leasing
POSTGRES_PASSWORD=
POSTGRES_DB=leasing

# Encryption key for n8n's credential store. Generate with:
#   node scripts/generate-secrets.js
# If this changes, every stored credential becomes unreadable.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Tunnel - public HTTPS URL for inbound webhooks
# ---------------------------------------------------------------------------
# Required by: Telegram Trigger, Cal.com booking webhooks, DocuSign Connect.
# cloudflared quick tunnels get a NEW hostname every run, and n8n reads these
# only at container start. After any tunnel or Docker restart:
#   node scripts/start-tunnel.js
TUNNEL_URL=
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# ---------------------------------------------------------------------------
# CREDENTIALS - fill these in, then run: node scripts/setup-credentials.js
# ---------------------------------------------------------------------------

# OpenAI - the only paid dependency. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Telegram - create a bot with @BotFather, then message it once and run
# scripts/get-telegram-chat-id.js to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# Plaid Sandbox - free, unlimited. https://dashboard.plaid.com/developers/keys
# Use the SANDBOX secret, not development or production.
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_ENV=sandbox

# Cal.com - free plan. Settings > Developer > API keys.
CALCOM_API_KEY=
# Event type used for tour bookings; filled in during Stage 3.
CALCOM_EVENT_TYPE_ID=

# DocuSign developer sandbox - https://developers.docusign.com
# JWT grant: integration key, the user id (GUID) of the account, and the RSA
# private key saved to docusign-private.key (gitignored).
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_BASE=https://account-d.docusign.com
DOCUSIGN_PRIVATE_KEY_PATH=docusign-private.key

# Airtable - DISPLAY MIRROR ONLY, never the system of record.
# PAT scopes: schema.bases:write, data.records:read, data.records:write
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Email - SMTP out, IMAP in. Uses a Gmail App Password, NOT the account password.
# Requires 2-Step Verification on the account, then:
#   https://myaccount.google.com/apppasswords
# No Google Cloud project or OAuth consent screen needed.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Prospect mailbox - plays the renter. Needs its own Gmail App Password so the
# fixture lead email and prospect replies can be scripted. MUST be a different
# account from GMAIL_ADDRESS above: Gmail delivers self-addressed mail to INBOX
# as well as Sent, so a single account makes the IMAP trigger re-read our own
# outbound mail.
PROSPECT_GMAIL_ADDRESS=
PROSPECT_GMAIL_APP_PASSWORD=
PROSPECT_SMTP_HOST=smtp.gmail.com
PROSPECT_SMTP_PORT=465


# ---------------------------------------------------------------------------
# Demo routing - where demo email actually lands during testing
# ---------------------------------------------------------------------------
DEMO_RECIPIENT_EMAIL=
DEMO_FROM_EMAIL=
