      "id": "callout",
      "type": "rectangle",
      "x": 80,
      "y": 818,
      "width": 1700,
      "height": 176,
      "strokeColor": "#868e96",
      "backgroundColor": "#f1f3f5",
      "fillStyle": "solid"
    },
    {
      "angle": 0,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2021414,
      "version": 1,
      "versionNonce": 2031421,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789244562972,
      "link": null,
      "locked": false,
      "id": "callout-title",
      "type": "text",
      "x": 100,
      "y": 834,
      "width": 1650,
      "height": 23,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "What the system never does",
      "originalText": "What the system never does",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 18
    },
    {
      "angle": 0,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2041428,
      "version": 1,
      "versionNonce": 2051435,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789244562972,
      "link": null,
      "locked": false,
      "id": "callout-body",
      "type": "text",
      "x": 100,
      "y": 868,
      "width": 1650,
      "height": 76,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "It never decides.  The AI reads documents and answers questions; a deterministic engine applies the manager's published criteria; a person makes every rental decision.\nIt never scores or ranks an applicant, and never infers anything about a protected class.\nIt never sends a denial.  A file that fails criteria stops and hands to a human - real adverse action is a formal FCRA process, and automating it is how operators end up in class actions.\nIt does not even decide what to ask next, or when a tour may happen.  The gate picks the next question and its wording is fixed; tour hours are the manager's, published in advance and applied identically.",
      "originalText": "It never decides.  The AI reads documents and answers questions; a deterministic engine applies the manager's published criteria; a person makes every rental decision.\nIt never scores or ranks an applicant, and never infers anything about a protected class.\nIt never sends a denial.  A file that fails criteria stops and hands to a human - real adverse action is a formal FCRA process, and automating it is how operators end up in class actions.\nIt does not even decide what to ask next, or when a tour may happen.  The gate picks the next question and its wording is fixed; tour hours are the manager's, published in advance and applied identically.",
