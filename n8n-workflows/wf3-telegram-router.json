  "nodes": [
    {
      "id": "telegram-trigger",
      "name": "Manager Actions (Telegram)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -620,
        0
      ],
      "parameters": {
        "updates": [
          "callback_query",
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "__TELEGRAM_CREDENTIAL_ID__",
          "name": "Leasing Telegram (manager bot)"
        }
      },
      "webhookId": "leasing-telegram-router"
    },
    {
      "id": "parse-manager-action",
      "name": "Parse Manager Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// callback_data is capped at 64 bytes, so it carries a three-letter action\n// and the application reference only - never a decision payload.\nconst ACTIONS = {\n  apr: { decision: 'approved', label: 'Approved', triggers_lease: true },\n  con: { decision: 'conditional', label: 'Approved with conditions', triggers_lease: true },\n  rev: { decision: 'sent_to_review', label: 'Sent for closer review', triggers_lease: false },\n};\n\nconst out = [];\nfor (const item of $input.all()) {\n  const update = item.json;\n  const callback = update.callback_query;\n\n  if (!callback) {\n    // Not a button tap. Nothing else enters this workflow yet.\n    continue;\n  }\n\n  const raw = String(callback.data || '');\n  const separator = raw.indexOf(':');\n  const prefix = separator === -1 ? '' : raw.slice(0, separator);\n  const refToken = separator === -1 ? '' : raw.slice(separator + 1);\n  const action = ACTIONS[prefix];\n\n  // Tour approvals are a different kind of tap: they decide a viewing time,\n  // not an application, and they must never touch the applications table.\n  const TOUR = { tba: true, tbd: false };\n  const isTour = Object.prototype.hasOwnProperty.call(TOUR, prefix);\n\n  if ((!action && !isTour) || !refToken) {\n    throw new Error('Unrecognised callback_data: ' + raw);\n  }\n\n  const from = callback.from || {};\n  const actor = from.username ? '@' + from.username\n    : [from.first_name, from.last_name].filter(Boolean).join(' ') || String(from.id || 'unknown');\n\n  out.push({ json: {\n    ref_token: refToken,\n    is_tour_decision: isTour,\n    tour_approved: isTour ? TOUR[prefix] : null,\n    decision: isTour ? null : action.decision,\n    decision_label: isTour ? (TOUR[prefix] ? 'Tour approved' : 'Tour time declined') : action.label,\n    triggers_lease: isTour ? false : action.triggers_lease,\n    actor: actor,\n    callback_query_id: callback.id,\n    chat_id: (callback.message && callback.message.chat && callback.message.chat.id) || null,\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "acknowledge-tap",
      "name": "Acknowledge Tap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot__TELEGRAM_BOT_TOKEN__/answerCallbackQuery",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callback_query_id: $json.callback_query_id }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
