      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        40,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.*, u.unit_code, u.address, u.rent_amount, u.deposit_amount, u.lease_term_months,\n       (a.decision IS NOT NULL) AS already_decided\nFROM applications a JOIN units u ON u.id = a.unit_id\nWHERE a.ref_token = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$('Parse Manager Action').first().json.ref_token] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "Leasing Postgres"
        }
      }
    },
