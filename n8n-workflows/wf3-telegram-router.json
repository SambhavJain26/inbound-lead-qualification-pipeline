      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE applications SET\n  decision = $2,\n  decided_by = $3,\n  decided_at = now(),\n  status = 'decided'\nWHERE ref_token = $1 AND decision IS NULL\nRETURNING *, (SELECT unit_code FROM units WHERE id = applications.unit_id) AS unit_code;",
        "options": {
          "queryReplacement": "={{ [$('Parse Manager Action').first().json.ref_token,$('Parse Manager Action').first().json.decision,$('Parse Manager Action').first().json.actor] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "Leasing Postgres"
        }
      }
    },
